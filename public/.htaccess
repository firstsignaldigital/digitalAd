<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Existing files and directories win (assets, images, robots.txt, sitemap.xml,
  # favicons, and every prerendered *.html page).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Extensionless route -> its prerendered file (/about -> /about.html,
  # /services/seo -> /services/seo.html).
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
  RewriteRule ^ %{REQUEST_URI}.html [L]
</IfModule>

# Unknown paths return the prerendered 404 page.
ErrorDocument 404 /404.html
